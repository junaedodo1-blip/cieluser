{
  "name": "@open-design/remotion-pipeline",
  "version": "1.0.0",
  "description": "Viral Motion Graphic Video Pipeline with Remotion and Asset Ingestion",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "remotion preview src/index.ts",
    "build": "tsc --noEmit",
    "render": "remotion render src/index.ts ViralPromoVertical out/video.mp4 --codec h264 --crf 17",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.509",
    "@remotion/media": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.3"
  }
}
